{
  "expo": {
    "name": "HalalForMe",
    "slug": "HalalForMe",
    "scheme": "halalforme",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#245737"
    },
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1",
      "bundleIdentifier": "com.halalforme.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "HalalForMe uses your camera to scan product barcodes and to take photos of restaurants and food."
      }
    },
    "android": {
      "package": "com.halalforme.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#245737",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HalalForMe needs your location to show halal restaurants near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HalalForMe needs access to your photos to upload restaurant and food images."
        }
      ],
      "expo-camera",
      "expo-background-task",
      "expo-localization"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e5a2f979-21b3-48cf-a4a0-1097a9e3d2f9"
      }
    }
  }
}
